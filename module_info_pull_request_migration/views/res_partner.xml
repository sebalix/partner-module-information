<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_module_partner_kanban" model="ir.ui.view">
        <field name="model">res.partner</field>
        <field
            name="inherit_id"
            ref="module_info_migration.view_module_partner_kanban"
        />
        <field name="arch" type="xml">
            <field name="migrated_module_nbr" position="after">
                <field name="pull_request_nbr" />
            </field>
            <a name="get_action_migration_tree" position="after">
                <a name="get_action_pull_request_tree" type="object">
                    <br />
                    <span>Pull Requests
                        <t t-esc="record.target_odoo_version_id.value" />:
                        <t t-esc="record.pull_request_nbr.value" />
                    </span>
                </a>
            </a>
        </field>
    </record>

</odoo>
