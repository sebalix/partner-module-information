<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="pull_request_tree_view" model="ir.ui.view">
        <field name="name">pull.request.tree.view</field>
        <field name="model">pull.request</field>
        <field name="arch" type="xml">
            <tree
                decoration-warning="blocked_for_one_week"
                decoration-danger="blocked_for_one_month"
            >
                <field name="title" />
                <field name="repo_id" />
                <field name="module_ids" widget="many2many_tags" />
                <field name="orga" />
                <field name="author" />
                <field name="date_open" />
                <field name="date_updated" />
                <field name="date_closed" />
                <field name="version_id" />
                <field name="state" />
                <field name="date_last_state_changed" />
                <field name="waiting_reviewer_ids" widget="many2many_tags" />
                <field name="approved_reviewer_ids" widget="many2many_tags" />
                <field name="refused_reviewer_ids" widget="many2many_tags" />
                <field name="blocked_for_one_week" invisible="1" />
                <field name="blocked_for_one_month" invisible="1" />
                <button
                    name="open_url"
                    type="object"
                    string="Open"
                    icon="fa-arrow-right"
                />
            </tree>
        </field>
    </record>


    <record id="pull_request_form_view" model="ir.ui.view">
        <field name="name">pull.request.form.view</field>
        <field name="model">pull.request</field>
        <field name="arch" type="xml">
            <form string="Pull Request">
                <header>
                    <button
                        name="update_pr"
                        class="oe_highlight"
                        string="Update manually"
                        type="object"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,need_reviewer,waiting_review,approved,approved_by_ak,done"
                    />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="title" />
                        </h1>
                    </div>
                    <group name="pr_head">
                        <group>
                            <field name="repo_id" />
                            <field name="orga" />
                            <field name="author" />
                            <field name="author_user_id" />
                            <field name="date_open" />
                            <field name="date_updated" />
                            <field name="date_closed" />
                            <field name="date_last_state_changed" />
                        </group>
                        <group>
                            <field name="state" />
                            <field
                                name="is_dead"
                                attrs="{'invisible': [('state', '!=', 'cancel')]}"
                            />
                            <field name="version_id" />
                            <field name="url" widget="url" />
                            <field name="number" />
                        </group>
                    </group>
                    <group name="pr_info">
                        <group>
                        <field name="module_ids" widget="many2many_tags" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="pull_request_search_view" model="ir.ui.view">
        <field name="name">pull.request.search.view</field>
        <field name="model">pull.request</field>
        <field name="arch" type="xml">
            <search string="Pull Request">
                <field name="orga" />
                <field name="author" />
                <field name="author_user_id" />
                <field name="module_ids" />
                <field name="repo_id" />
                <filter
                    name="opened"
                    string="Opened PR"
                    domain="[('state', 'not in', ['cancel', 'done'])]"
                />
                <filter
                    name="closed"
                    string="Closed PR"
                    domain="[('state', 'in', ['cancel', 'done'])]"
                />
                <separator />
                <filter
                    name="v14"
                    string="V14"
                    domain="[('version_id', '=', '14.0')]"
                />
                <filter
                    name="v15"
                    string="V15"
                    domain="[('version_id', '=', '15.0')]"
                />
                <filter name="v16" string="V16" domain="" />
                <separator />
                <filter
                    name="mypr"
                    string="My PR"
                    domain="[('author_user_id', '=', uid )]"
                />
                <separator />
                <filter
                    name="my_waiting_review"
                    string="Waiting for my Review"
                    domain="[('waiting_reviewer_ids.user_id', '=', uid)]"
                />
                <separator />
                <filter
                    name="blocked_for_one_week"
                    string="Blocked for one week+"
                    domain="[('blocked_for_one_week', '=', True)]"
                />
                <filter
                    name="blocked_for_one_month"
                    string="Blocked for one month+"
                    domain="[('blocked_for_one_month', '=', True)]"
                />
                <separator />
                <group expand="0" string="Group By">
                    <filter
                        name="group_by_state"
                        string="State"
                        context="{'group_by': 'state'}"
                    />
                    <filter
                        name="group_by_repo"
                        string="Repo"
                        context="{'group_by': 'repo_id'}"
                    />
                    <filter
                        name="group_by_orga"
                        string="Organization"
                        context="{'group_by': 'orga'}"
                    />
                    <filter
                        name="group_by_author"
                        string="Author"
                        context="{'group_by': 'author'}"
                    />
                    <filter
                        name="group_by_author_user"
                        string="Author User"
                        context="{'group_by': 'author_user_id'}"
                    />
                    <filter
                        name="group_by_version"
                        string="Version"
                        context="{'group_by': 'version_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="pull_request_action" model="ir.actions.act_window">
        <field name="name">Pull Request</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">pull.request</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="pull_request_search_view" />
        <field name="context">{'search_default_opened': 1}</field>
    </record>

    <menuitem
        id="pull_request_main_menu"
        name="PR"
        parent="module_info_partner.module_info_menu_root"
        action="pull_request_action"
        sequence="2"
    />

</odoo>
